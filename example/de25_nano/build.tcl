# Quartus Prime Pro batch build for the DE25-Nano JPEG-LS encoder demo.
# Usage: quartus_sh -t build.tcl
#
# Environment:
#   FCAPZ_ROOT      - path to fpgacapZero repo (defaults to <repo>/fcapz)
#   JLS_CLK_MHZ     - fabric clock generated by the IOPLL from the 50 MHz
#                     board clock (default 150; timing closes up to about 160)
#   JLS_QUARTUS_OUT - project directory (default <this dir>/quartus_out)

set example_dir [file normalize [file dirname [info script]]]
set jls_root    [file normalize $example_dir/../..]

set default_fcapz_root [file normalize $jls_root/fcapz]
set fcapz_root [expr {[info exists ::env(FCAPZ_ROOT)] ? $::env(FCAPZ_ROOT) : $default_fcapz_root}]
if {![file isdirectory $fcapz_root]} {
    puts "ERROR: fpgacapZero not found at $fcapz_root"
    puts "Set FCAPZ_ROOT or initialize the fcapz submodule"
    exit 1
}

set clk_mhz [expr {[info exists ::env(JLS_CLK_MHZ)] ? $::env(JLS_CLK_MHZ) : 150}]
if {![string is double -strict $clk_mhz] || $clk_mhz < 10 || $clk_mhz > 300} {
    puts "ERROR: JLS_CLK_MHZ must be a frequency in MHz, got '$clk_mhz'"
    exit 1
}

set project_name de25_jls_demo
set project_dir  [expr {[info exists ::env(JLS_QUARTUS_OUT)] ? [file normalize $::env(JLS_QUARTUS_OUT)] : "$example_dir/quartus_out"}]
set output_dir   $project_dir/output_files

if {[file isdirectory $project_dir]} {
    file delete -force $project_dir
}
file mkdir $project_dir

# -- Fabric clock IOPLL (50 MHz board clock -> JLS_CLK_MHZ) ---------
set ip_deploy [file normalize $::quartus(binpath)/../../qsys/bin/ip-deploy]
puts "IOPLL: 50 MHz -> $clk_mhz MHz"
if {[catch {exec $ip_deploy --component-name=altera_iopll --output-name=jls_iopll \
        "--family=Agilex 5" --part=A5EB013BB23BE4SR1 --output-directory=$project_dir \
        --component-parameter=gui_reference_clock_frequency=50.0 \
        --component-parameter=gui_output_clock_frequency0=$clk_mhz \
        --component-parameter=gui_use_locked=true} msg]} {
    if {![file exists $project_dir/jls_iopll.ip]} {
        puts "ERROR: ip-deploy failed: $msg"
        exit 1
    }
}

project_new -overwrite -revision $project_name $project_dir/$project_name
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY $output_dir
set_global_assignment -name SEARCH_PATH $fcapz_root/rtl
set_global_assignment -name SEARCH_PATH $fcapz_root/rtl/jtag_tap
source $example_dir/de25_jls.qsf

# -- Source RTL --------------------------------------------------
foreach src [list \
    $jls_root/RTL/jls_encoder.v \
    $jls_root/example/arty_a7/rtl/sync_fifo.v \
    $jls_root/example/arty_a7/rtl/axi_jls_ctrl.v \
    $example_dir/rtl/de25_jls_top.v \
    $fcapz_root/rtl/fcapz_async_fifo.v \
    $fcapz_root/rtl/fcapz_ejtagaxi.v \
    $fcapz_root/rtl/fcapz_ejtagaxi_intel.v \
    $fcapz_root/rtl/jtag_tap/jtag_tap_intel.v \
] {
    set_global_assignment -name VERILOG_FILE $src
}
set_global_assignment -name IP_FILE $project_dir/jls_iopll.ip
set_global_assignment -name SDC_FILE $example_dir/de25_jls.sdc

# -- Compile (synthesis, fit, timing, assembler) ------------------
if {[catch {execute_flow -compile} err]} {
    project_close
    puts "ERROR: Quartus compile failed: $err"
    exit 1
}
project_close

# -- Timing check: refuse to ship a bitstream that misses timing ----
set sta_rpt $output_dir/${project_name}.sta.rpt
set fh [open $sta_rpt r]
set sta [read $fh]
close $fh
set slack_re {Worst-case Slack\s*;\s*(-?[0-9.]+)\s*;\s*(-?[0-9.]+)\s*;\s*(-?[0-9.]+)\s*;\s*(-?[0-9.]+)}
if {![regexp $slack_re $sta -> setup hold recovery removal]} {
    puts "ERROR: no multicorner timing summary in $sta_rpt"
    exit 1
}
puts "Worst-case slack (ns): setup $setup, hold $hold, recovery $recovery, removal $removal"
if {$setup < 0 || $hold < 0 || $recovery < 0 || $removal < 0} {
    puts "ERROR: timing not met at $clk_mhz MHz; lower JLS_CLK_MHZ"
    puts "(the unchecked bitstream is in $output_dir)"
    exit 1
}

file copy -force $output_dir/${project_name}.sof $example_dir/de25_jls_top.sof
puts "\n=== Build complete: example/de25_nano/de25_jls_top.sof (fabric clock $clk_mhz MHz) ==="
